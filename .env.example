# Database
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5433/portfolio_dev"

# Auth.js (owner-only GitHub OAuth)
NEXTAUTH_SECRET="generate-a-strong-secret-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3005"
GITHUB_CLIENT_ID="your-github-oauth-app-id"
GITHUB_CLIENT_SECRET="your-github-oauth-app-secret"

# Owner GitHub numeric user ID (allowlist)
# Only this user can sign in. Find yours at:
#   https://api.github.com/users/<your-username>
# Look for the "id" field (e.g., 1234567).
AUTH_OWNER_GITHUB_ID="your-github-numeric-user-id"
