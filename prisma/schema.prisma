generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  draft
  published
  archived
}

enum ContentVisibility {
  public
  privateRoom
  adminOnly
}

model Project {
  id          String            @id @default(cuid())
  slug        String            @unique
  title       String
  summary     String
  body        String?
  stack       String[]
  outcome     String?
  status      ContentStatus     @default(draft)
  visibility  ContentVisibility @default(public)
  order       Int               @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  milestones    Milestone[]
  privateRooms  PrivateRoom[]
  buildLogEntries BuildLogEntry[]
  createdAt     DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Milestone {
  id          String            @id @default(cuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      ContentStatus     @default(draft)
  visibility  ContentVisibility @default(public)
  order       Int               @default(0)
  targetDate  DateTime?
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([projectId])
}

model PrivateRoom {
  id              String            @id @default(cuid())
  projectId       String
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  slug            String            @unique
  showMilestones  Boolean           @default(true)
  showUpdates     Boolean           @default(true)
  showArchitecture Boolean          @default(true)
  showEvidence    Boolean           @default(true)
  showNextSteps   Boolean           @default(true)
  status          ContentStatus     @default(draft)
  visibility      ContentVisibility @default(privateRoom)
  tokens          AccessToken[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([projectId])
}

model AccessToken {
  id         String     @id @default(cuid())
  roomId     String
  room       PrivateRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tokenHash  String     @unique
  label      String?
  revokedAt  DateTime?
  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([roomId])
}

model BuildLogEntry {
  id          String            @id @default(cuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  body        String?
  occurredAt  DateTime          @default(now())
  status      ContentStatus     @default(draft)
  visibility  ContentVisibility @default(public)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([projectId])
  @@index([occurredAt])
}
