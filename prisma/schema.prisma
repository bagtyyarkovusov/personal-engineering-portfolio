generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  draft
  published
  archived
}

enum ContentVisibility {
  public
  privateRoom
  adminOnly
}

model Project {
  id          String            @id @default(cuid())
  slug        String            @unique
  title       String
  summary     String
  body        String?
  stack       String[]
  outcome     String?
  status      ContentStatus     @default(draft)
  visibility  ContentVisibility @default(public)
  order       Int               @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  milestones  Milestone[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Milestone {
  id          String            @id @default(cuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      ContentStatus     @default(draft)
  visibility  ContentVisibility @default(public)
  order       Int               @default(0)
  targetDate  DateTime?
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([projectId])
}
